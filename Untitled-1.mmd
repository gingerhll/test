flowchart TD
    RECEIVE["Bob receives<br/>IV and Ciphertext C"] --> DECRYPT["AES-256-CTR Decryption"]
    KEY["Shared secret key K<sub>A</sub>"] --> DECRYPT
    DECRYPT --> DATA["Recover plaintext fields<br/>MsgNo | ID<sub>A</sub> | M | ID<sub>B</sub> | Z"]
    DATA --> CALCULATE["<div style='width:300px'>Recalculate<br/>Z' = M ⊕ ID<sub>A</sub> ⊕ ID<sub>B</sub>"]
